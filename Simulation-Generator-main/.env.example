# Docker Compose does NOT strip inline `#` comments from values in this file —
# `OPENAI_API_KEY=  # set me` makes the key literally "# set me". Keep every
# comment on its own line.
#
# Compose also substitutes an undefined variable with an empty string rather than
# failing, so a missing key surfaces as a confusing runtime error, not a startup one.

POSTGRES_DB=simgen
POSTGRES_USER=simgen
# set me
POSTGRES_PASSWORD=
# service name on the compose network, not localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=simgen
# set me
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# set me — required from day one, powers simulation generation (LLM call #2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=16384

# Ollama — powers plan generation (LLM call #1). Points at a local Ollama
# server (`ollama pull qwen3:4b` first); api_key is a required-but-ignored
# placeholder. host.docker.internal reaches the host machine from inside the
# api/celery containers.
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MAX_OUTPUT_TOKENS=16384

# Words of a lab's textbook section sent to plan generation (LLM call #1). The plan
# model's context also holds the system prompt, the schema, its thinking, and the
# blueprint. Raise this only with a larger context on the Ollama server
# (OLLAMA_CONTEXT_LENGTH=16384 or more).
TEXTBOOK_EXCERPT_MAX_WORDS=900

APP_PORT=8000
WORKERS=4
ALLOWED_HOSTS=api,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEBUG=true
FAKE_AUTH=true
FAKE_USER_SUB=dev-teacher
LOCAL_DEV=true
CELERY_WORKER_MAX_MEMORY_PER_CHILD=512000
